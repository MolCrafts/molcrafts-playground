{
  "jupyter-lite-schema-version": 0,
  "jupyter-config-data": {
    "appName": "MolCrafts Playground",
    "appUrl": "./lab",
    "litePluginSettings": {
      "@jupyterlite/pyodide-kernel-extension:kernel": {
        "loadPyodideOptions": {
          "lockFileURL": "./static/pyodide-lock.json",
          "packages": [
            "micropip",
            "numpy",
            "molcrafts-molpy",
            "molcrafts-molvis"
          ]
        }
      }
    }
  }
}
